{
  "entities": {
    "userProfile": {
      "title": "UserProfile",
      "description": "User account information and workspace settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "description": "User email address" },
        "displayName": { "type": "string", "description": "User display name" },
        "photoURL": { "type": "string", "description": "Avatar URL" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "marketingCampaign": {
      "title": "MarketingCampaign",
      "description": "AI generated marketing campaign record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "title": { "type": "string" },
        "domain": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "title"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/userProfile" },
      "description": "User profile collection"
    },
    "/campaigns/{campaignId}": {
      "schema": { "$ref": "#/entities/marketingCampaign" },
      "description": "Marketing campaigns created by users"
    }
  }
}
